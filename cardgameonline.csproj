<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="OhHell.Core/OhHell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="OhHell.Core/**/*.cs" />
    <Compile Remove="OhHell.Web/**/*.cs" />
    <Compile Remove="OhHell.Web/**/*.razor" />
    <EmbeddedResource Remove="OhHell.Web/**/*.razor" />
    <Content Remove="OhHell.Web/**" />
    <None Remove="OhHell.Web/**" />
  </ItemGroup>
</Project>
